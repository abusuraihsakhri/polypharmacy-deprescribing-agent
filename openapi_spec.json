{
  "openapi": "3.1.0",
  "info": {
    "title": "Polypharmacy Deprescribing Agent API",
    "version": "3.0.0-ENTERPRISE",
    "description": "Synthetic metric and status-flag rule demonstration. No medication-specific guideline logic, PHI certification, or clinical decision support."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health and metadata",
        "responses": {
          "200": {
            "description": "JSON health response"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Process-local counters",
        "responses": {
          "200": {
            "description": "JSON metrics (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate generic synthetic thresholds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "target_identifier": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic evaluation and process-local HMAC metadata hash"
          },
          "400": {
            "description": "Potential identifier pattern detected"
          },
          "422": {
            "description": "Invalid request fields"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response; not a model-backed assistant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock text response"
          },
          "400": {
            "description": "Potential identifier pattern detected"
          },
          "422": {
            "description": "Invalid request fields"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read process-local audit metadata (optional admin endpoint)",
        "description": "Disabled by default. Set AUDIT_LOG_READ_TOKEN to enable; supply Authorization: Bearer <token>.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Audit metadata and signature integrity check"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Endpoint not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
